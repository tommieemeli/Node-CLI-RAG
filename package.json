{
  "name": "rag-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Retrieve-then-read RAG CLI over local text files",
  "scripts": {
    "ingest": "tsx src/cli.ts ingest ./docs",
    "ask": "tsx src/cli.ts ask",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@huggingface/transformers": "^4.2.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
