# Copy to .env and adjust. Every key is optional; defaults are in src/config.ts.

# Required only for `rag ask` — `rag ingest` and the test suite never need it.
ANTHROPIC_API_KEY=

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=3
SIMILARITY_THRESHOLD=0.32

# Models
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
ANTHROPIC_MODEL=claude-opus-5

# Where the ingested vectors are persisted
STORE_PATH=.rag/store.json
